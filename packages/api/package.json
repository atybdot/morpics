{
  "name": "@morpics/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "./schema": {
      "types": "./dist/schema",
      "default": "./dist/schema.ts"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@morpics/auth": "workspace:*",
    "@morpics/buckets": "workspace:*",
    "@morpics/db": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@morpics/config": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
