{
  "name": "morpics",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "server:typegen": "pnpm --filter server typegen",
    "auth:typegen": "pnpm --filter auth-service typegen"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "nanoid": "^5.1.6",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^22.19.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "tsdown": "^0.15.12",
    "turbo": "^2.7.2"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.27.0"
}
