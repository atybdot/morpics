{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "wrangler dev --port=3002 --config wrangler.local.jsonc",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/zod": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@morpics/api": "workspace:*",
    "@morpics/auth": "workspace:*",
    "@morpics/db": "workspace:*",
    "@morpics/sdk": "workspace:*",
    "@morpics/buckets": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "@morpics/config": "workspace:*",
    "wrangler": "^4.40.3",
    "@types/node": "catalog:"
  }
}
